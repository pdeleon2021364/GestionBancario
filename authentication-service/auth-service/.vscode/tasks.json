{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build AuthService.Api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AuthService.Api/AuthService.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run AuthService.Api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/AuthService.Api/AuthService.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
